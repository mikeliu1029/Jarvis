# Copy this file to .env and fill in what you use.

# --- Voice (recommended): Gemini Live - natural voice, fast replies. Free key: https://aistudio.google.com/apikey
# Without it Jarvis runs fully locally (Ollama + Whisper + Kokoro), which is slower.
GEMINI_API_KEY=

# --- Cloud brain: only when brain.provider = "anthropic" in config/settings.toml ---
ANTHROPIC_API_KEY=

# --- Cloud voices: set tts.engine = "elevenlabs" or "fishaudio" in settings.toml ---
ELEVENLABS_API_KEY=
# "Daniel" (British, authoritative). "George" (British, warm) = JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5

FISH_AUDIO_API_KEY=
# The ID of any voice model on fish.audio (there are community JARVIS-style voices)
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s1

# --- Calendar (read-only): one or more iCal links, comma-separated ---
# Google Calendar: Settings > (your calendar) > Integrate calendar > "Secret address in iCal format"
# Outlook: Settings > Calendar > Shared calendars > Publish a calendar > ICS link
CALENDAR_ICS_URL=

# --- Email (read-only, IMAP). Gmail: turn on 2-Step Verification, then create an App Password ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
